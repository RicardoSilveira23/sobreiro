// The pill's face: what Core's PillModel looks like on the taskbar, in DIPs, drawn as 1.1's WPF
// pill draws it. The Rust side (src/pill_face.rs) fills `FaceData` from the model and the colours;
// this file only draws.
// The fonts are the 1.x app's, read from where they are until the C# leaves this branch.
import "../../../src/Sobreiro/Fonts/Inter-Regular.ttf";
import "../../../src/Sobreiro/Fonts/Inter-Medium.ttf";
import "../../../src/Sobreiro/Fonts/Unbounded-Bold.ttf";
import { SecondPass } from "second-pass.slint";

// A label and its figure as text ("45%", or a dash); `star` adds "*" after the figure of a block
// whose numbers have stopped.
export struct FaceLine {
    label: string,
    figure: string,
    star: bool,
}

export struct FaceData {
    show-claude: bool,
    show-copilot: bool,
    // The pointer is over the pill.
    hovered: bool,
    // The ink, the ring and bar track (ink at 0x26), the reset date (ink at 0x99), and the ground
    // at rest (ink at alpha 1, so clicks land) and under the pointer (ink at 0x1A).
    ink: color,
    track: color,
    secondary: color,
    ground: color,
    ground-hover: color,
    session: FaceLine,
    weekly: FaceLine,
    // Degrees clockwise from 12 o'clock to draw with round caps (0: no fill, 360 or more: full).
    outer-sweep: float,
    outer-fill: color,
    inner-sweep: float,
    inner-fill: color,
    copilot: FaceLine,
    reset-date: string,
    // 0 to 1, filling the bar from the bottom.
    bar-fraction: float,
    bar-fill: color,
}

// DIPs, as 1.1's PillView.
global Metrics {
    out property <length> label-size: 12px;
    out property <length> figure-size: 11px;
    out property <length> reset-size: 11px;
    out property <length> rings-size: 26px;
    out property <length> stroke: 3px;
    out property <length> ring-gap: 2px;
    out property <length> text-to-rings: 8px;
    out property <length> block-gap: 12px;
    out property <length> bar-width: 5px;
    out property <length> bar-height: 26px;
    out property <length> pad-x: 8px;
    out property <length> pad-y: 4px;
    // How much larger than its real size a text is measured at: see `Measure`.
    out property <float> measure-scale: 1000;
    // Every text is drawn twice, the second time with its alpha times a factor k that depends on
    // the window's scale, so a pixel's alpha a becomes a + k * a * (1 - a). The software renderer
    // uses a glyph's coverage as alpha with no gamma step, so its text is lighter than 1.1's. A
    // thin glyph has more partly covered pixels and gains more from a second pass than a bold one,
    // so the labels, `*` and reset date (Inter) and the figures (Unbounded Bold) have factors of
    // their own, picked so the text column's summed alpha matches 1.1's in every state (see the
    // `face` test). The renderer also cuts a glyph's size to whole pixels (11 DIPs at 150% is drawn
    // at 16 px, laid out at 16.5): a figure's second pass is drawn at the next whole pixel, 17,
    // which puts back the ink the cut takes and leaves no stronger row under the baseline.
    out property <float> label-pass-100: 0.26;
    out property <float> label-pass-150: 0.35;
    out property <float> label-pass-200: 0.18;
    out property <float> figure-pass-100: 0.82;
    out property <float> figure-pass-150: 0.65;
    out property <float> figure-pass-200: 0.38;

    public pure function label-pass(scale: float) -> float {
        return SecondPass.between(scale, label-pass-100, label-pass-150, label-pass-200);
    }

    public pure function figure-pass(scale: float) -> float {
        return SecondPass.between(scale, figure-pass-100, figure-pass-150, figure-pass-200);
    }
}

// Measures a text at `measure-scale` times its size; never drawn. The toolkit rounds a text's
// preferred width up to a whole unit, which at 1000 times costs a thousandth of a DIP per text,
// so a line's sum stays within half a pixel's rounding of its natural width: divide the width
// by `Metrics.measure-scale` for the natural width.
component Measure inherits Text {
    in property <length> unit-size;
    font-size: root.unit-size * Metrics.measure-scale;
    visible: false;
    // Not for a screen reader: it is only measured.
    accessible-role: none;
}

// A ring: a track all the way round, and the fill as an arc from 12 o'clock.
component Ring inherits Rectangle {
    in property <length> radius;
    in property <float> sweep;
    in property <color> fill;
    in property <color> track;
    width: Metrics.rings-size;
    height: Metrics.rings-size;

    private property <length> outer: root.radius + Metrics.stroke / 2;
    private property <length> centre: Metrics.rings-size / 2;

    Rectangle {
        x: root.centre - root.outer;
        y: root.centre - root.outer;
        width: root.outer * 2;
        height: root.outer * 2;
        border-radius: root.outer;
        border-width: Metrics.stroke;
        border-color: root.track;
    }

    if root.sweep >= 360: Rectangle {
        x: root.centre - root.outer;
        y: root.centre - root.outer;
        width: root.outer * 2;
        height: root.outer * 2;
        border-radius: root.outer;
        border-width: Metrics.stroke;
        border-color: root.fill;
    }

    // The toolkit fits a stroked path into its box less the stroke, offset by half a stroke, so the
    // box is one stroke larger than the canvas and starts half a stroke before it: the viewbox
    // then lies on the canvas unscaled, and the arc on its track.
    if root.sweep > 0 && root.sweep < 360: Path {
        x: -Metrics.stroke / 2;
        y: -Metrics.stroke / 2;
        width: Metrics.rings-size + Metrics.stroke;
        height: Metrics.rings-size + Metrics.stroke;
        viewbox-width: 26;
        viewbox-height: 26;
        stroke: root.fill;
        stroke-width: Metrics.stroke;
        stroke-line-cap: round;
        MoveTo {
            x: 13;
            y: 13 - root.radius / 1px;
        }
        ArcTo {
            radius-x: root.radius / 1px;
            radius-y: root.radius / 1px;
            x: 13 + root.radius / 1px * sin(root.sweep * 1deg);
            y: 13 - root.radius / 1px * cos(root.sweep * 1deg);
            large-arc: root.sweep > 180;
            sweep: true;
        }
    }
}

// A label, a space, a figure and "*" when the figure is a last reading, right-aligned in a column
// and each at its natural width, on one baseline: the largest ascent of the three, from the top of
// the line, as WPF sets runs in a block. WPF sets a line as one text, so its width is the sum of
// the advances; `natural` is that sum, and the column the block rounds once.
component Line inherits Rectangle {
    in property <FaceLine> line;
    in property <color> ink;
    // The width of the block's text column: its widest line, rounded to a device pixel.
    in property <length> column;
    in property <length> line-height;
    out property <length> natural: (label-m.preferred-width + space-m.preferred-width + figure-m.preferred-width + (root.line.star ? star-m.preferred-width : 0px)) / Metrics.measure-scale;
    width: root.column;
    height: root.line-height;

    // The second passes' colours: the ink at a fraction of its alpha.
    private property <color> label-twin: root.ink.transparentize(1 - Metrics.label-pass(1px / 1phx));
    private property <color> figure-twin: root.ink.transparentize(1 - Metrics.figure-pass(1px / 1phx));
    private property <length> baseline: round(max(label.font-metrics.ascent, figure.font-metrics.ascent) / 1phx) * 1phx;
    private property <length> star-width: root.line.star ? star-m.preferred-width / Metrics.measure-scale : 0px;
    private property <length> figure-x: root.column - root.star-width - figure-m.preferred-width / Metrics.measure-scale;
    private property <length> label-x: root.figure-x - space-m.preferred-width / Metrics.measure-scale - label-m.preferred-width / Metrics.measure-scale;

    label-m := Measure { text: root.line.label; font-family: "Inter"; unit-size: Metrics.label-size; }
    space-m := Measure { text: " "; font-family: "Inter"; unit-size: Metrics.label-size; }
    figure-m := Measure { text: root.line.figure; font-family: "Unbounded"; font-weight: 700; unit-size: Metrics.figure-size; }
    star-m := Measure { text: "*"; font-family: "Inter"; unit-size: Metrics.label-size; }

    label := Text {
        text: root.line.label;
        font-family: "Inter";
        font-size: Metrics.label-size;
        color: root.ink;
        x: root.label-x;
        y: root.baseline - self.font-metrics.ascent;
        height: self.preferred-height;
        accessible-role: none;
    }

    Text {
        text: root.line.label;
        font-family: "Inter";
        font-size: Metrics.label-size;
        color: root.label-twin;
        x: root.label-x;
        y: root.baseline - label.font-metrics.ascent;
        height: label.preferred-height;
        accessible-role: none;
    }

    figure := Text {
        text: root.line.figure;
        font-family: "Unbounded";
        font-weight: 700;
        font-size: Metrics.figure-size;
        color: root.ink;
        x: root.figure-x;
        y: root.baseline - self.font-metrics.ascent;
        height: self.preferred-height;
        accessible-role: none;
    }

    // At the figure's size rounded up to whole pixels (the same size at 100% and 200%), ending
    // where the figure ends, on its baseline.
    Text {
        text: root.line.figure;
        font-family: "Unbounded";
        font-weight: 700;
        font-size: ceil(Metrics.figure-size / 1phx) * 1phx;
        color: root.figure-twin;
        x: root.figure-x + figure.preferred-width - self.preferred-width;
        y: root.baseline - self.font-metrics.ascent;
        height: self.preferred-height;
        accessible-role: none;
    }

    if root.line.star: Text {
        text: "*";
        font-family: "Inter";
        font-size: Metrics.label-size;
        color: root.ink;
        x: root.column - root.star-width;
        y: root.baseline - self.font-metrics.ascent;
        height: self.preferred-height;
        accessible-role: none;
    }

    if root.line.star: Text {
        text: "*";
        font-family: "Inter";
        font-size: Metrics.label-size;
        color: root.label-twin;
        x: root.column - root.star-width;
        y: root.baseline - self.font-metrics.ascent;
        height: self.preferred-height;
        accessible-role: none;
    }
}

// Claude's two lines in one text column: the widest line's natural width, rounded once to the
// nearest device pixel as WPF's layout rounds a text's width, so the rings after it lie on whole
// pixels.
component ClaudeText inherits VerticalLayout {
    in property <FaceLine> session;
    in property <FaceLine> weekly;
    in property <color> ink;
    in property <length> line-height;
    private property <length> column: round(max(first.natural, second.natural) / 1phx) * 1phx;
    alignment: center;

    first := Line { line: root.session; ink: root.ink; column: root.column; line-height: root.line-height; }
    second := Line { line: root.weekly; ink: root.ink; column: root.column; line-height: root.line-height; }
}

// Copilot's credits line and the reset date under it, right-aligned in one column rounded as
// Claude's is.
component CopilotText inherits VerticalLayout {
    in property <FaceLine> credits;
    in property <string> reset-date;
    in property <color> ink;
    in property <color> secondary;
    in property <length> line-height;
    in property <length> reset-height;
    private property <length> column: round(max(first.natural, reset-m.preferred-width / Metrics.measure-scale) / 1phx) * 1phx;
    alignment: center;
    spacing: 0px;

    // Out of the layout's sizing: a measurer is 100 times as wide as the text.
    Rectangle {
        width: 0px;
        height: 0px;
        reset-m := Measure {
            text: root.reset-date;
            font-family: "Inter";
            unit-size: Metrics.reset-size;
        }
    }

    first := Line { line: root.credits; ink: root.ink; column: root.column; line-height: root.line-height; }
    // The date and its second pass share one box, so the layout sees one child.
    Rectangle {
        width: root.column;
        height: root.reset-height;
        Text {
            text: root.reset-date;
            font-family: "Inter";
            font-size: Metrics.reset-size;
            color: root.secondary;
            horizontal-alignment: right;
            vertical-alignment: top;
            accessible-role: none;
            width: parent.width;
            height: parent.height;
        }
        Text {
            text: root.reset-date;
            font-family: "Inter";
            font-size: Metrics.reset-size;
            color: root.secondary.transparentize(1 - Metrics.label-pass(1px / 1phx));
            horizontal-alignment: right;
            vertical-alignment: top;
            accessible-role: none;
            width: parent.width;
            height: parent.height;
        }
    }
}

export component PillFace inherits Rectangle {
    in property <FaceData> data;
    // The size the pill wants, for the window that holds it.
    out property <length> face-width: row.preferred-width;
    out property <length> face-height: row.preferred-height;
    width: root.face-width;
    height: root.face-height;
    border-radius: 4px;
    background: root.data.hovered ? root.data.ground-hover : root.data.ground;

    // A line is the font's line height rounded to whole device pixels at the window's scale, as WPF
    // sets one: Inter 12 is 14.52 DIPs (15, 22, 29 px at 100%, 150%, 200%), Inter 11 is 13.31
    // (13, 20, 27 px).
    private property <length> line-height: round((label-ref.font-metrics.ascent - label-ref.font-metrics.descent) / 1phx) * 1phx;
    private property <length> reset-height: round((reset-ref.font-metrics.ascent - reset-ref.font-metrics.descent) / 1phx) * 1phx;

    label-ref := Text {
        font-family: "Inter";
        font-size: Metrics.label-size;
        visible: false;
        accessible-role: none;
    }

    reset-ref := Text {
        font-family: "Inter";
        font-size: Metrics.reset-size;
        visible: false;
        accessible-role: none;
    }

    row := HorizontalLayout {
        padding-left: Metrics.pad-x;
        padding-right: Metrics.pad-x;
        padding-top: Metrics.pad-y;
        padding-bottom: Metrics.pad-y;
        spacing: 0px;

        if root.data.show-claude: HorizontalLayout {
            spacing: Metrics.text-to-rings;
            ClaudeText {
                session: root.data.session;
                weekly: root.data.weekly;
                ink: root.data.ink;
                line-height: root.line-height;
            }
            VerticalLayout {
                alignment: center;
                // Outer ring: 5h. Inner: 7d, a stroke and a gap inside it.
                Rectangle {
                    width: Metrics.rings-size;
                    height: Metrics.rings-size;
                    Ring {
                        radius: Metrics.rings-size / 2 - Metrics.stroke / 2;
                        sweep: root.data.outer-sweep;
                        fill: root.data.outer-fill;
                        track: root.data.track;
                    }
                    Ring {
                        radius: Metrics.rings-size / 2 - Metrics.stroke / 2 - Metrics.stroke - Metrics.ring-gap;
                        sweep: root.data.inner-sweep;
                        fill: root.data.inner-fill;
                        track: root.data.track;
                    }
                }
            }
        }

        if root.data.show-copilot: HorizontalLayout {
            spacing: Metrics.text-to-rings;
            padding-left: root.data.show-claude ? Metrics.block-gap : 0px;
            CopilotText {
                credits: root.data.copilot;
                reset-date: root.data.reset-date;
                ink: root.data.ink;
                secondary: root.data.secondary;
                line-height: root.line-height;
                reset-height: root.reset-height;
            }
            VerticalLayout {
                alignment: center;
                // A rounded track, and over it a rounded fill the height of the bar, shown through a
                // rectangular window that covers the filled part from the bottom: both ends round,
                // since the software renderer does not clip to a border radius.
                Rectangle {
                    width: Metrics.bar-width;
                    height: Metrics.bar-height;
                    border-radius: Metrics.bar-width / 2;
                    background: root.data.track;
                    Rectangle {
                        width: parent.width;
                        height: parent.height * max(0, min(1, root.data.bar-fraction));
                        y: parent.height - self.height;
                        clip: true;
                        Rectangle {
                            y: -(parent.y);
                            width: parent.width;
                            height: Metrics.bar-height;
                            border-radius: Metrics.bar-width / 2;
                            background: root.data.bar-fill;
                        }
                    }
                }
            }
        }
    }
}

// The pill on the taskbar: the face in a window of its own size, over nothing, with no frame. The
// size is in units; the toolkit keeps it when the window's scale changes and resizes the window.
export component Pill inherits Window {
    in property <FaceData> data;
    out property <length> pill-width: face.face-width;
    out property <length> pill-height: face.face-height;
    width: face.face-width;
    height: face.face-height;
    no-frame: true;
    background: transparent;
    title: "Sobreiro";

    // The tooltip's text, which is also the pill's name for a screen reader.
    in property <string> name;
    // The pointer came onto the pill or left it.
    callback hover-changed(bool);
    // A button went down on the pill, for any button.
    callback pressed();
    callback left-clicked();
    callback right-clicked();

    face := PillFace {
        x: 0px;
        y: 0px;
        data: root.data;
    }

    // Over the face, taking the pointer for the whole window.
    touch := TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        accessible-role: button;
        accessible-label: root.name;
        accessible-action-default => {
            root.left-clicked();
        }
        changed has-hover => {
            root.hover-changed(self.has-hover);
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.pressed();
            }
            // As 1.1: a click is the button coming up with the pointer still on the pill. Where
            // it is comes from the area's bounds, not from `has-hover`: after a menu's own loop
            // the toolkit may not know the pointer is on the pill.
            if event.kind == PointerEventKind.up && self.mouse-x >= 0px && self.mouse-x < self.width && self.mouse-y >= 0px && self.mouse-y < self.height {
                if event.button == PointerEventButton.left {
                    root.left-clicked();
                } else if event.button == PointerEventButton.right {
                    root.right-clicked();
                }
            }
        }
    }
}

// The face alone in a window of its own size, over nothing: what `--pill-pictures` draws.
export component PillPicture inherits Window {
    in property <FaceData> data;
    out property <length> pill-width: face.face-width;
    out property <length> pill-height: face.face-height;
    background: transparent;

    face := PillFace {
        x: 0px;
        y: 0px;
        data: root.data;
    }
}
