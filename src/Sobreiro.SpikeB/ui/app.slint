// SPIKE (shell candidate B). Step 1's test window: half-clear red with a solid white dot. The taskbar must
// show through the red and around the round corners.
export component Probe inherits Window {
    title: "Sobreiro pill";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 140px;
    height: 36px;
    Rectangle {
        border-radius: 18px;
        background: #e0303080;
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: white;
        }
    }
}
