import { Pill, PillFace, PillLine, PillFaceView, Tip } from "pill.slint";
export { Pill, PillFace, PillLine, Tip }
import { Flyout, FlyoutCard, LimitRow } from "flyout.slint";
export { Flyout, FlyoutCard, LimitRow }
import { Tray } from "tray.slint";
export { Tray }

// SPIKE (shell candidate B). Step 1's test window: half-clear red with a solid white dot. The taskbar must
// show through the red and around the round corners.
export component Probe inherits Window {
    in property <bool> on-top: true;
    callback hover-changed(bool);
    title: "Sobreiro pill";
    no-frame: true;
    always-on-top: on-top;
    background: transparent;
    width: 140px;
    height: 36px;
    Rectangle {
        border-radius: 18px;
        background: #e0303080;
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: white;
        }

        TouchArea {
            changed has-hover => {
                root.hover-changed(self.has-hover);
            }
        }
    }
}

// For `--snapshot` only: pill faces side by side on a taskbar's colour.
export component Sheet inherits Window {
    in property <[PillFace]> faces;
    in property <color> ground;
    out property <length> sheet-width: row.preferred-width;
    title: "Sobreiro snapshot";
    no-frame: true;
    background: ground;
    height: 52px;
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 24px;
        alignment: start;
        for face in faces: PillFaceView {
            face: face;
            hovered: false;
        }
    }
}
